---
/**
 * Etiqueta "✦ BLACK NOVEMBER" em cima do título do hero da home.
 * Só decorativa: sem oferta, sem preço, sem link. Vai dentro de .hero__content.
 * Some sozinha em FIM (horário de Brasília): o site é estático, então o
 * script inline remove na tela do visitante; build feito depois de FIM nem inclui.
 *
 * Limpeza depois de 30/11/2026: apagar este arquivo e, em src/pages/index.astro,
 * o import e o <SeloBlackNovember />.
 */
const FIM = '2026-11-30T23:59:00-03:00';
const ativo = Date.now() < Date.parse(FIM);
---

{ativo && (
  <>
    <p class="bn-tag"><span aria-hidden="true">✦</span> Black <b>November</b></p>
    <script is:inline define:vars={{ FIM }}>
      if (Date.now() >= Date.parse(FIM)) document.querySelector(".bn-tag")?.remove();
    </script>
  </>
)}

<style>
  .bn-tag {
    position: relative;
    overflow: hidden;
    width: fit-content;
    margin: 0 0 20px;
    padding: 5px 18px 8px;
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    background: #0a0a0a;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 21px;
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
    animation: bn-tag-brilho 3s ease-in-out infinite;
  }
  .bn-tag b,
  .bn-tag span {
    color: var(--color-accent);
    font-weight: inherit;
  }
  /* estrela girando */
  .bn-tag span {
    display: inline-block;
    animation: bn-tag-gira 6s linear infinite;
  }
  /* reflexo de luz passando por cima */
  .bn-tag::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.28) 50%, transparent 65%);
    transform: translateX(-120%);
    animation: bn-tag-reflexo 3s ease-in-out infinite;
  }
  @keyframes bn-tag-brilho {
    0%, 100% { box-shadow: 0 0 0 0 rgb(255 101 48 / 0); }
    50% { box-shadow: 0 0 18px 2px rgb(255 101 48 / 0.55); }
  }
  @keyframes bn-tag-gira {
    to { transform: rotate(360deg); }
  }
  @keyframes bn-tag-reflexo {
    0%, 55% { transform: translateX(-120%); }
    100% { transform: translateX(120%); }
  }
  @media (max-width: 767px) {
    .bn-tag {
      margin-bottom: 16px;
      padding: 4px 14px 6px;
      font-size: 17px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .bn-tag,
    .bn-tag span,
    .bn-tag::after {
      animation: none;
    }
  }
</style>
