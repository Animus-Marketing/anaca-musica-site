---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import { getCollection, render } from 'astro:content';
import albunsData from '../../data/albuns.json';

type Album = { pasta: string; fotos: { nome: string; w: number; h: number }[] };
const todos: Record<string, Album> = albunsData;

export async function getStaticPaths() {
  const eventos = await getCollection('eventos');
  return eventos.map(evento => ({
    params: { slug: evento.data.slug },
    props: { evento },
  }));
}

const { evento } = Astro.props;
const { Content } = await render(evento);

// Galeria: evento com `albuns` mostra todas as fotos dos álbuns (miniatura na grade, média ao abrir).
// Sem `albuns`, vale a lista `galeria` do .md. Baixar a foto boa é só na página interna /fotos/<slug>/,
// que não tem link daqui de propósito.
type Foto = { mini: string; grande: string; w?: number; h?: number };
const fotos: Foto[] = evento.data.albuns?.length
  ? evento.data.albuns.flatMap(id => {
      if (!todos[id]) throw new Error(`Álbum "${id}" não existe em src/data/albuns.json`);
      const { pasta, fotos } = todos[id];
      return fotos.map(f => ({ mini: `${pasta}/mini/${f.nome}.webp`, grande: `${pasta}/media/${f.nome}.webp`, w: f.w, h: f.h }));
    })
  : (evento.data.galeria ?? []).map(src => ({ mini: src, grande: src }));
// Galeria grande fica sem data-reveal: a animação só dispara com 12% do bloco na tela
// (BaseLayout), e um bloco de 180 fotos nunca chega nisso. Ficaria invisível para sempre.
const revelar = fotos.length > 40 ? undefined : 'fade-in';
// aceita o link inteiro (watch?v=, youtu.be/, shorts/, embed/) ou só o id
const video = evento.data.video_youtube?.trim();
const videoId = video && (video.match(/(?:shorts\/|embed\/|watch\?v=|youtu\.be\/)([\w-]{6,})/)?.[1] ?? video);
---

<BaseLayout
  title={evento.data.titulo}
  description={[evento.data.titulo, evento.data.local].filter(Boolean).join(' - ')}
  image={evento.data.imagem_capa}
>
  <Hero
    title={evento.data.titulo}
    subtitles={["Eventos"]}
    backgroundImage="/images/cursos/microfone-hero.webp"
    compact
  />

  <div class="container section">
    <div class="prose evento-prose" data-reveal="fade-up">
      <Content />
    </div>

    {videoId && (
      <div class="evento-video" data-reveal="fade-in">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${videoId}?rel=0`}
          title={`Vídeo: ${evento.data.titulo}`}
          loading="lazy"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
          allowfullscreen
        ></iframe>
      </div>
    )}

    {fotos.length > 0 && (
      <div class="evento-galeria" data-reveal={revelar}>
        {fotos.map((foto, i) => (
          <a href={foto.grande} class="evento-galeria__item" data-lightbox="galeria">
            <img
              src={foto.mini}
              alt={`${evento.data.titulo} ${i + 1}`}
              loading="lazy"
              width={foto.w}
              height={foto.h}
            />
          </a>
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .evento-prose {
    margin-bottom: var(--space-xl);
  }

  .evento-prose :global(h2) {
    display: none;
  }

  .evento-prose :global(p) {
    color: var(--color-text-muted);
    font-size: 17px;
    font-weight: 300;
    line-height: 1.7em;
    margin-bottom: var(--space-md);
  }

  .evento-prose :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .evento-video {
    aspect-ratio: 16 / 9;
    margin-bottom: var(--space-xl);
  }

  .evento-video iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Masonry gallery */
  .evento-galeria {
    columns: 4;
    column-gap: 10px;
  }

  .evento-galeria__item {
    display: block;
    margin-bottom: 10px;
    break-inside: avoid;
    cursor: pointer;
  }

  .evento-galeria__item img {
    width: 100%;
    height: auto;
    display: block;
    transition: opacity 0.2s;
  }

  .evento-galeria__item:hover img {
    opacity: 0.8;
  }

  @media (max-width: 1024px) {
    .evento-galeria { columns: 3; }
  }

  @media (max-width: 768px) {
    .evento-galeria { columns: 2; }
  }

</style>

<style is:global>
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: rgba(0, 0, 0, 0.92);
    display: none;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
  }

  .lightbox-overlay.active {
    display: flex;
  }

  .lightbox-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
  }

  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    color: #fff;
    font-size: 32px;
    background: none;
    border: none;
    cursor: pointer;
    line-height: 1;
  }

  .lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    color: #fff;
    font-size: 40px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 20px;
    line-height: 1;
  }

  .lightbox-prev { left: 10px; }
  .lightbox-next { right: 10px; }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-lightbox]');
    if (!links.length) return;

    const srcs = Array.from(links).map(a => a.href);
    let current = 0;

    // Create overlay
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    overlay.innerHTML = `
      <button class="lightbox-close" aria-label="Fechar">&times;</button>
      <button class="lightbox-nav lightbox-prev" aria-label="Anterior">&#8249;</button>
      <img src="" alt="" />
      <button class="lightbox-nav lightbox-next" aria-label="Próxima">&#8250;</button>
    `;
    document.body.appendChild(overlay);

    const img = overlay.querySelector('img')!;
    const show = (i: number) => { current = i; img.src = srcs[current]; };

    links.forEach((a, i) => {
      a.addEventListener('click', (e) => {
        e.preventDefault();
        show(i);
        overlay.classList.add('active');
      });
    });

    overlay.querySelector('.lightbox-close')!.addEventListener('click', () => overlay.classList.remove('active'));
    overlay.querySelector('.lightbox-prev')!.addEventListener('click', (e) => { e.stopPropagation(); show((current - 1 + srcs.length) % srcs.length); });
    overlay.querySelector('.lightbox-next')!.addEventListener('click', (e) => { e.stopPropagation(); show((current + 1) % srcs.length); });
    overlay.addEventListener('click', (e) => { if (e.target === overlay) overlay.classList.remove('active'); });

    document.addEventListener('keydown', (e) => {
      if (!overlay.classList.contains('active')) return;
      if (e.key === 'Escape') overlay.classList.remove('active');
      if (e.key === 'ArrowLeft') show((current - 1 + srcs.length) % srcs.length);
      if (e.key === 'ArrowRight') show((current + 1) % srcs.length);
    });
  });
</script>
